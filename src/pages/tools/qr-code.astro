---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="QR Code Generator | mroux"
  description="Client-side QR code generator with theming, logo upload, and PNG export."
>
  <section class="qr-tool" data-qr-tool>
    <div>
      <h1>QR Code Generator</h1>
      <p class="lede">Generate a styled QR code locally in your browser. Nothing is uploaded.</p>
    </div>

    <div class="qr-grid">
      <form class="qr-controls" autocomplete="off" data-controls>
        <section class="control-section">
          <h2>Content</h2>
          <label for="content">Text or URL</label>
          <textarea id="content" name="content" rows="3">https://mroux.net</textarea>
        </section>

        <section class="control-section">
          <h2>Logo Adjustments</h2>
          <div class="field-row">
            <label for="logoUpload">Upload logo</label>
            <input id="logoUpload" name="logoUpload" type="file" accept="image/*" />
          </div>
          <div class="field-row">
            <label for="logoCropMode">Crop mode</label>
            <select id="logoCropMode" name="logoCropMode">
              <option value="none">None</option>
              <option value="circle">Circle</option>
              <option value="rounded">Rounded rectangle</option>
            </select>
          </div>
          <div class="field-row">
            <label for="logoSize">Logo size <span class="field-meta" data-logo-size-label>24% of QR width</span></label>
            <input id="logoSize" name="logoSize" type="range" min="0.12" max="0.5" step="0.01" value="0.24" />
          </div>
          <div class="field-row">
            <label for="logoZoom">Image crop <span class="field-meta" data-logo-zoom-label>50%</span></label>
            <input id="logoZoom" name="logoZoom" type="range" min="0" max="100" step="1" value="50" />
          </div>
          <div class="field-row">
            <label for="logoMargin">Logo exclusion buffer</label>
            <input id="logoMargin" name="logoMargin" type="range" min="0" max="24" value="8" />
          </div>
          <div class="field-row checkbox-row">
            <input id="autoColor" name="autoColor" type="checkbox" checked />
            <label for="autoColor">Auto-pick foreground from logo</label>
          </div>
          <button type="button" class="secondary" data-action="apply-logo-color">Apply logo color now</button>
        </section>

        <section class="control-section">
          <h2>Quick Presets</h2>
          <div class="preset-row">
            <button type="button" class="secondary" data-preset="clean">Clean</button>
            <button type="button" class="secondary" data-preset="soft">Soft Brand</button>
            <button type="button" class="secondary" data-preset="bold">Bold Contrast</button>
            <button type="button" class="secondary" data-preset="ink">Minimal Ink</button>
          </div>
        </section>

        <details class="control-section control-disclosure" open>
          <summary>QR Appearance</summary>
          <div class="control-disclosure-body">
            <div class="field-row">
              <label for="foreground">Foreground</label>
              <input id="foreground" name="foreground" type="color" value="#111827" />
            </div>
            <div class="field-row">
              <label for="background">Background</label>
              <input id="background" name="background" type="color" value="#ffffff" />
            </div>
            <div class="field-row checkbox-row">
              <input id="transparentBackground" name="transparentBackground" type="checkbox" />
              <label for="transparentBackground">Transparent background</label>
            </div>
            <div class="field-row">
              <label for="dotsStyle">Dot style</label>
              <select id="dotsStyle" name="dotsStyle">
                <option value="square">Square</option>
                <option value="dots">Dots</option>
                <option value="rounded">Rounded</option>
                <option value="extra-rounded">Extra Rounded</option>
                <option value="classy">Classy</option>
                <option value="classy-rounded">Classy Rounded</option>
              </select>
            </div>
            <div class="field-row">
              <label for="cornersSquareStyle">Corner square style</label>
              <select id="cornersSquareStyle" name="cornersSquareStyle">
                <option value="square">Square</option>
                <option value="dot">Dot</option>
                <option value="extra-rounded">Extra Rounded</option>
              </select>
            </div>
            <div class="field-row">
              <label for="cornersDotStyle">Corner dot style</label>
              <select id="cornersDotStyle" name="cornersDotStyle">
                <option value="square">Square</option>
                <option value="dot">Dot</option>
              </select>
            </div>
          </div>
        </details>

        <details class="control-section control-disclosure">
          <summary>Advanced QR Settings</summary>
          <div class="control-disclosure-body">
            <div class="field-row">
              <label for="size">Size <span class="field-meta" data-size-label>560 x 560 px</span></label>
              <input id="size" name="size" type="range" min="240" max="1200" value="560" />
            </div>
            <div class="field-row">
              <label for="errorCorrectionLevel">Error correction</label>
              <select id="errorCorrectionLevel" name="errorCorrectionLevel">
                <option value="L">Low (L)</option>
                <option value="M">Medium (M)</option>
                <option value="Q">Quartile (Q)</option>
                <option value="H" selected>High (H)</option>
              </select>
            </div>
            <div class="field-row">
              <label for="margin">Quiet Zone</label>
              <input id="margin" name="margin" type="range" min="0" max="50" value="18" />
            </div>
          </div>
        </details>
      </form>

      <aside class="qr-preview-col">
        <section class="preview-card">
          <h2>Preview</h2>
          <div class="qr-preview" data-preview>
            <canvas data-preview-canvas></canvas>
          </div>
          <div class="actions preview-actions">
            <button type="button" data-action="download">Download PNG</button>
            <button type="button" class="secondary" data-action="reset">Reset Safe Defaults</button>
            <button type="button" class="secondary" data-action="remove-logo">Remove logo</button>
          </div>
        </section>

        <section class="warning-card" aria-live="polite">
          <div class="warning-heading">
            <h2>Warnings</h2>
            <span class="warning-count" data-warning-count>0</span>
          </div>
          <ul data-warnings>
            <li>No warnings.</li>
          </ul>
        </section>

        <details class="reliability-card control-disclosure">
          <summary>Scan Reliability Tips</summary>
          <div class="control-disclosure-body">
            <ul>
              <li>Keep high contrast between foreground and background.</li>
              <li>Keep a visible quiet zone around the QR.</li>
              <li>Avoid oversized center logos.</li>
              <li>Test on at least one iOS and one Android phone camera.</li>
              <li>Print and scan a small test before full production.</li>
            </ul>
          </div>
        </details>
      </aside>
    </div>
  </section>

  <script>
    import QRCodeStyling from "qr-code-styling";

    const root = document.querySelector("[data-qr-tool]");
    const controls = root?.querySelector("[data-controls]");
    const preview = root?.querySelector("[data-preview]");
    const previewCanvas = root?.querySelector("[data-preview-canvas]");
    const warningsList = root?.querySelector("[data-warnings]");
    const warningCount = root?.querySelector("[data-warning-count]");
    const sizeLabel = root?.querySelector("[data-size-label]");
    const logoSizeLabel = root?.querySelector("[data-logo-size-label]");
    const logoZoomLabel = root?.querySelector("[data-logo-zoom-label]");
    const warningCard = root?.querySelector(".warning-card");
    if (!root || !controls || !preview || !previewCanvas || !warningsList || !warningCount || !sizeLabel || !logoSizeLabel || !logoZoomLabel || !warningCard) {
      throw new Error("QR tool did not initialize.");
    }

    const safeDefaults = {
      content: "https://mroux.net",
      size: 560,
      margin: 18,
      foreground: "#111827",
      background: "#ffffff",
      transparentBackground: false,
      dotsStyle: "square",
      cornersSquareStyle: "square",
      cornersDotStyle: "square",
      errorCorrectionLevel: "H",
      logoCropMode: "none",
      logoSize: 0.24,
      logoZoom: 50,
      logoMargin: 8,
      autoColor: true
    };

    const presets = {
      clean: {
        foreground: "#111827",
        background: "#ffffff",
        dotsStyle: "square",
        cornersSquareStyle: "square",
        cornersDotStyle: "square",
        transparentBackground: false,
        logoCropMode: "none"
      },
      soft: {
        foreground: "#0f766e",
        background: "#ffffff",
        dotsStyle: "rounded",
        cornersSquareStyle: "extra-rounded",
        cornersDotStyle: "dot",
        transparentBackground: false,
        logoCropMode: "rounded"
      },
      bold: {
        foreground: "#0b1220",
        background: "#f3f4f6",
        dotsStyle: "classy-rounded",
        cornersSquareStyle: "extra-rounded",
        cornersDotStyle: "dot",
        transparentBackground: false,
        logoCropMode: "circle"
      },
      ink: {
        foreground: "#1f2937",
        background: "#ffffff",
        dotsStyle: "dots",
        cornersSquareStyle: "square",
        cornersDotStyle: "dot",
        transparentBackground: false,
        logoCropMode: "none"
      }
    };

    const state = {
      ...safeDefaults,
      logoDataUrl: "",
      extractedLogoColor: null,
      logoFileSize: 0,
      runtimeError: ""
    };

    const errorCorrectionCoverage = {
      L: 0.07,
      M: 0.15,
      Q: 0.25,
      H: 0.3
    };
    const maxLogoExclusionUsage = 0.85;

    const form = controls;
    const getField = (name) => form.elements.namedItem(name);
    const toInt = (value) => Number.parseInt(value, 10);
    const toFloat = (value) => Number.parseFloat(value);
    const hasLogo = () => Boolean(state.logoDataUrl);

    const syncLogoErrorCorrectionLock = () => {
      const errorCorrectionField = getField("errorCorrectionLevel");
      const logoIsPresent = hasLogo();
      errorCorrectionField.disabled = logoIsPresent;
      if (logoIsPresent) {
        state.errorCorrectionLevel = "H";
        errorCorrectionField.value = "H";
      }
    };

    const updateFieldsFromState = () => {
      for (const key of Object.keys(safeDefaults)) {
        const field = getField(key);
        if (!field) continue;
        if (field.type === "checkbox") {
          field.checked = Boolean(state[key]);
        } else {
          field.value = String(state[key]);
        }
      }
      sizeLabel.textContent = `${state.size} x ${state.size} px`;
      logoSizeLabel.textContent = `${Math.round(state.logoSize * 100)}% of QR width`;
      logoZoomLabel.textContent = `${state.logoZoom}%`;
    };

    const updateLiveLabels = () => {
      sizeLabel.textContent = `${getField("size").value} x ${getField("size").value} px`;
      logoSizeLabel.textContent = `${Math.round(toFloat(getField("logoSize").value) * 100)}% of QR width`;
      logoZoomLabel.textContent = `${getField("logoZoom").value}%`;
    };

    const parseHex = (hex) => {
      const cleaned = hex.replace("#", "");
      const expanded = cleaned.length === 3 ? cleaned.split("").map((c) => c + c).join("") : cleaned;
      const num = Number.parseInt(expanded, 16);
      return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
    };

    const luminance = ({ r, g, b }) => {
      const f = (c) => {
        const v = c / 255;
        return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
      };
      return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
    };

    const contrastRatio = (a, b) => {
      const la = luminance(parseHex(a));
      const lb = luminance(parseHex(b));
      const hi = Math.max(la, lb);
      const lo = Math.min(la, lb);
      return (hi + 0.05) / (lo + 0.05);
    };

    const buildWarnings = () => {
      const warnings = [];
      if (state.runtimeError) warnings.push(state.runtimeError);
      if (!state.content.trim()) warnings.push("Input is empty.");
      if (state.transparentBackground) {
        warnings.push("Transparent background can reduce scan reliability on low-contrast surfaces.");
      } else if (contrastRatio(state.foreground, state.background) < 3) {
        warnings.push("Foreground/background contrast is low; scanning may fail.");
      }
      if (state.margin < 8) warnings.push("Quiet zone is small; increase margin for better print reliability.");
      if (state.logoSize > 0.3) warnings.push("Logo covers a large share of the QR width; scanning may fail even if the PNG file stays small.");
      if (hasLogo() && getLogoImageSize() >= maxLogoExclusionUsage) {
        warnings.push("Logo plus exclusion buffer is near the safe limit for high error correction; reduce its size or buffer for more reliable scanning.");
      }
      if (state.logoFileSize > 1024 * 1024) warnings.push("Uploaded logo is over 1MB and may affect performance.");
      return warnings;
    };

    const renderWarnings = () => {
      const warnings = buildWarnings();
      warningCount.textContent = String(warnings.length);
      warningCount.hidden = warnings.length === 0;
      warningCard.classList.toggle("warning-card-active", warnings.length > 0);
      warningsList.innerHTML = "";
      if (!warnings.length) {
        const li = document.createElement("li");
        li.textContent = "No warnings.";
        warningsList.appendChild(li);
        return;
      }
      for (const warning of warnings) {
        const li = document.createElement("li");
        li.textContent = warning;
        warningsList.appendChild(li);
      }
    };

    const clearLogo = () => {
      const logoUpload = getField("logoUpload");
      logoUpload.value = "";
      state.logoDataUrl = "";
      state.extractedLogoColor = null;
      state.logoFileSize = 0;
      syncLogoErrorCorrectionLock();
    };

    const setRuntimeError = (message) => {
      state.runtimeError = message;
      renderWarnings();
    };

    const clearRuntimeError = () => {
      state.runtimeError = "";
    };

    const extractLogoColor = (imageData) => {
      const buckets = new Map();
      for (let i = 0; i < imageData.data.length; i += 4) {
        const r = imageData.data[i];
        const g = imageData.data[i + 1];
        const b = imageData.data[i + 2];
        const a = imageData.data[i + 3];
        if (a < 180) continue;
        if (r > 245 && g > 245 && b > 245) continue;
        const key = `${Math.floor(r / 16) * 16},${Math.floor(g / 16) * 16},${Math.floor(b / 16) * 16}`;
        buckets.set(key, (buckets.get(key) || 0) + 1);
      }
      if (!buckets.size) return null;
      let topKey = null;
      let topCount = 0;
      for (const [key, count] of buckets.entries()) {
        if (count > topCount) {
          topCount = count;
          topKey = key;
        }
      }
      if (!topKey) return null;
      const [r, g, b] = topKey.split(",").map(Number);
      return `#${[r, g, b].map((v) => v.toString(16).padStart(2, "0")).join("")}`;
    };

    const processLogo = async (file, cropMode, zoomPercent) => {
      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error("Failed to read logo file."));
        reader.readAsDataURL(file);
      });
      const image = await new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => reject(new Error("Failed to decode logo image."));
        img.src = dataUrl;
      });

      const side = 500;
      const canvas = document.createElement("canvas");
      canvas.width = side;
      canvas.height = side;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas context unavailable.");

      const containScale = Math.min(side / image.width, side / image.height);
      const coverScale = Math.max(side / image.width, side / image.height);
      const maxScale = coverScale * 1.9;
      const zoomRatio = zoomPercent / 100;
      const scale = containScale + (maxScale - containScale) * zoomRatio;
      const width = image.width * scale;
      const height = image.height * scale;
      const x = (side - width) / 2;
      const y = (side - height) / 2;

      ctx.drawImage(image, x, y, width, height);

      if (cropMode === "circle" || cropMode === "rounded") {
        ctx.globalCompositeOperation = "destination-in";
        ctx.beginPath();

        if (cropMode === "circle") {
          ctx.arc(side / 2, side / 2, side / 2, 0, Math.PI * 2);
        } else {
          const radius = side * 0.18;
          ctx.moveTo(radius, 0);
          ctx.lineTo(side - radius, 0);
          ctx.quadraticCurveTo(side, 0, side, radius);
          ctx.lineTo(side, side - radius);
          ctx.quadraticCurveTo(side, side, side - radius, side);
          ctx.lineTo(radius, side);
          ctx.quadraticCurveTo(0, side, 0, side - radius);
          ctx.lineTo(0, radius);
          ctx.quadraticCurveTo(0, 0, radius, 0);
        }

        ctx.closePath();
        ctx.fillStyle = "#000000";
        ctx.fill();
        ctx.globalCompositeOperation = "source-over";
      }

      const imageData = ctx.getImageData(0, 0, side, side);
      return {
        dataUrl: canvas.toDataURL("image/png"),
        color: extractLogoColor(imageData)
      };
    };

    const loadImage = (src) =>
      new Promise((resolve, reject) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error("Failed to load image."));
        image.src = src;
      });

    const drawRoundedRect = (ctx, x, y, width, height, radius) => {
      const safeRadius = Math.min(radius, width / 2, height / 2);
      ctx.beginPath();
      ctx.moveTo(x + safeRadius, y);
      ctx.lineTo(x + width - safeRadius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + safeRadius);
      ctx.lineTo(x + width, y + height - safeRadius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - safeRadius, y + height);
      ctx.lineTo(x + safeRadius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - safeRadius);
      ctx.lineTo(x, y + safeRadius);
      ctx.quadraticCurveTo(x, y, x + safeRadius, y);
      ctx.closePath();
    };

    const getLogoImageSize = () => {
      if (!hasLogo()) return 0;
      const qrDrawingWidth = Math.max(1, state.size - state.margin * 2);
      const exclusionWidth = state.size * state.logoSize + state.logoMargin * 2;
      const exclusionShare = Math.min(1, exclusionWidth / qrDrawingWidth);
      return Math.min(maxLogoExclusionUsage, (exclusionShare ** 2) / errorCorrectionCoverage.H);
    };

    const createLogoPlate = async () => {
      if (!hasLogo()) return undefined;

      const image = await loadImage(state.logoDataUrl);
      const side = 500;
      const requestedExclusionWidth = state.size * state.logoSize + state.logoMargin * 2;
      const inset = Math.min(side / 2, (state.logoMargin / requestedExclusionWidth) * side);
      const canvas = document.createElement("canvas");
      canvas.width = side;
      canvas.height = side;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas context unavailable.");

      ctx.fillStyle = "#ffffff";
      if (state.logoCropMode === "circle") {
        ctx.beginPath();
        ctx.arc(side / 2, side / 2, side / 2, 0, Math.PI * 2);
        ctx.fill();
      } else if (state.logoCropMode === "rounded") {
        drawRoundedRect(ctx, 0, 0, side, side, side * 0.18);
        ctx.fill();
      } else {
        ctx.fillRect(0, 0, side, side);
      }

      const imageSize = side - inset * 2;
      ctx.drawImage(image, inset, inset, imageSize, imageSize);
      return canvas.toDataURL("image/png");
    };

    const downloadCanvas = (canvas, filename) => {
      const link = document.createElement("a");
      link.download = filename;
      link.href = canvas.toDataURL("image/png");
      link.click();
    };

    const setButtonsDisabled = (selector, disabled) => {
      root.querySelectorAll(selector).forEach((button) => {
        button.disabled = disabled;
      });
    };

    const debounce = (fn, delay = 60) => {
      let timer;
      return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn(...args), delay);
      };
    };

    const syncStateFromFields = () => {
      state.content = getField("content").value;
      state.size = toInt(getField("size").value);
      state.margin = toInt(getField("margin").value);
      state.foreground = getField("foreground").value;
      state.background = getField("background").value;
      state.transparentBackground = getField("transparentBackground").checked;
      state.errorCorrectionLevel = getField("errorCorrectionLevel").value;
      state.dotsStyle = getField("dotsStyle").value;
      state.cornersSquareStyle = getField("cornersSquareStyle").value;
      state.cornersDotStyle = getField("cornersDotStyle").value;
      state.logoCropMode = getField("logoCropMode").value;
      state.logoSize = toFloat(getField("logoSize").value);
      state.logoZoom = toInt(getField("logoZoom").value);
      state.logoMargin = toInt(getField("logoMargin").value);
      state.autoColor = getField("autoColor").checked;
      syncLogoErrorCorrectionLock();
    };

    const qr = new QRCodeStyling({
      width: state.size,
      height: state.size,
      margin: state.margin,
      data: state.content,
      qrOptions: { errorCorrectionLevel: state.errorCorrectionLevel },
      dotsOptions: { color: state.foreground, type: state.dotsStyle },
      backgroundOptions: { color: state.background },
      cornersSquareOptions: { color: state.foreground, type: state.cornersSquareStyle },
      cornersDotOptions: { color: state.foreground, type: state.cornersDotStyle },
      imageOptions: { hideBackgroundDots: true, imageSize: 0, margin: 0 }
    });

    let renderToken = 0;
    let logoProcessToken = 0;
    let latestRenderPromise = Promise.resolve();

    const updateQr = async () => {
      const currentToken = ++renderToken;
      try {
        setButtonsDisabled('[data-action="download"]', true);
        const logoPlate = await createLogoPlate();
        if (currentToken !== renderToken) return;
        qr.update({
          width: state.size,
          height: state.size,
          margin: state.margin,
          data: state.content,
          qrOptions: { errorCorrectionLevel: state.errorCorrectionLevel },
          dotsOptions: { color: state.foreground, type: state.dotsStyle },
          backgroundOptions: { color: state.transparentBackground ? "transparent" : state.background },
          cornersSquareOptions: { color: state.foreground, type: state.cornersSquareStyle },
          cornersDotOptions: { color: state.foreground, type: state.cornersDotStyle },
          image: logoPlate || "",
          imageOptions: {
            hideBackgroundDots: hasLogo(),
            imageSize: getLogoImageSize(),
            margin: 0
          }
        });

        const blob = await qr.getRawData("png");
        if (!blob || currentToken !== renderToken) return;

        const objectUrl = URL.createObjectURL(blob);
        try {
          const qrImage = await loadImage(objectUrl);
          if (currentToken !== renderToken) return;
          previewCanvas.width = state.size;
          previewCanvas.height = state.size;
          const ctx = previewCanvas.getContext("2d");
          if (!ctx) throw new Error("Preview canvas context unavailable.");
          ctx.clearRect(0, 0, state.size, state.size);
          ctx.drawImage(qrImage, 0, 0, state.size, state.size);
        } finally {
          URL.revokeObjectURL(objectUrl);
        }
        clearRuntimeError();
      } catch (error) {
        if (currentToken === renderToken) {
          setRuntimeError(error instanceof Error ? error.message : "Preview render failed.");
        }
      } finally {
        setButtonsDisabled('[data-action="download"]', false);
      }
      if (currentToken === renderToken) {
        renderWarnings();
      }
    };

    const queueQrUpdate = () => {
      latestRenderPromise = updateQr();
      return latestRenderPromise;
    };

    const refreshLogoFromCurrentFile = async () => {
      const file = getField("logoUpload").files?.[0];
      if (!file) return false;
      const currentToken = ++logoProcessToken;
      const processed = await processLogo(file, getField("logoCropMode").value, toInt(getField("logoZoom").value));
      if (currentToken !== logoProcessToken) return false;
      state.logoFileSize = file.size;
      state.logoDataUrl = processed.dataUrl;
      state.extractedLogoColor = processed.color;
      syncLogoErrorCorrectionLock();
      if (state.autoColor && processed.color) {
        getField("foreground").value = processed.color;
      }
      clearRuntimeError();
      return true;
    };

    const handleControlsInput = debounce(() => {
      syncStateFromFields();
      updateLiveLabels();
      void queueQrUpdate();
    });

    form.addEventListener("input", handleControlsInput);
    form.addEventListener("change", handleControlsInput);

    root.querySelectorAll('[data-action="download"]').forEach((button) => {
      button.addEventListener("click", async () => {
        await latestRenderPromise;
        downloadCanvas(previewCanvas, "qr_code.png");
      });
    });

    root.querySelector('[data-action="apply-logo-color"]').addEventListener("click", () => {
      if (!state.extractedLogoColor) return;
      getField("foreground").value = state.extractedLogoColor;
      syncStateFromFields();
      void queueQrUpdate();
    });

    root.querySelectorAll('[data-action="remove-logo"]').forEach((button) => {
      button.addEventListener("click", () => {
        logoProcessToken += 1;
        clearLogo();
        clearRuntimeError();
        void queueQrUpdate();
      });
    });

    root.querySelectorAll('[data-action="reset"]').forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          Object.assign(state, safeDefaults);
          updateFieldsFromState();

          const file = getField("logoUpload").files?.[0];
          if (file) {
            const updated = await refreshLogoFromCurrentFile();
            if (!updated) return;
          } else {
            logoProcessToken += 1;
            clearLogo();
          }

          syncStateFromFields();
          void queueQrUpdate();
        } catch (error) {
          setRuntimeError(error instanceof Error ? error.message : "Reset failed.");
        }
      });
    });

    root.querySelectorAll("[data-preset]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          const preset = presets[button.dataset.preset];
          if (!preset) return;

          Object.assign(state, preset);
          getField("foreground").value = preset.foreground;
          getField("background").value = preset.background;
          getField("dotsStyle").value = preset.dotsStyle;
          getField("cornersSquareStyle").value = preset.cornersSquareStyle;
          getField("cornersDotStyle").value = preset.cornersDotStyle;
          getField("transparentBackground").checked = preset.transparentBackground;
          getField("logoCropMode").value = preset.logoCropMode;

          const file = getField("logoUpload").files?.[0];
          if (file) {
            await refreshLogoFromCurrentFile();
          }

          syncStateFromFields();
          void queueQrUpdate();
        } catch (error) {
          setRuntimeError(error instanceof Error ? error.message : "Preset application failed.");
        }
      });
    });

    getField("logoUpload").addEventListener("change", async () => {
      const file = getField("logoUpload").files?.[0];
      if (!file) {
        logoProcessToken += 1;
        clearLogo();
        void queueQrUpdate();
        return;
      }

      try {
        const updated = await refreshLogoFromCurrentFile();
        if (!updated) return;
        syncStateFromFields();
        void queueQrUpdate();
      } catch (error) {
        setRuntimeError(error instanceof Error ? error.message : "Logo processing failed.");
      }
    });

    getField("logoCropMode").addEventListener("change", async () => {
      try {
        const updated = await refreshLogoFromCurrentFile();
        if (!updated) return;
        syncStateFromFields();
        void queueQrUpdate();
      } catch (error) {
        setRuntimeError(error instanceof Error ? error.message : "Logo crop update failed.");
      }
    });

    getField("logoZoom").addEventListener("input", async () => {
      updateLiveLabels();
      try {
        const updated = await refreshLogoFromCurrentFile();
        if (!updated) return;
        syncStateFromFields();
        void queueQrUpdate();
      } catch (error) {
        setRuntimeError(error instanceof Error ? error.message : "Logo crop update failed.");
      }
    });

    updateFieldsFromState();
    updateLiveLabels();
    void queueQrUpdate();
  </script>
</BaseLayout>

